# Secrets come from the environment, never from this repository (Article IX).
# Copy this file to .env and fill it in. .env is in .gitignore.

# Long random string. Used to sign the JWT with HS256.
JWT_SECRET=

# Initial administrator, provisioned by the API on boot from these values.
# The database cannot seed it: only the hashing port can produce the hash.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=